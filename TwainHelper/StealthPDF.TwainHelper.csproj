<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- MUST be x86 so the 32-bit TWAIN Data Source Manager (twain_32.dll) and 32-bit scanner
         drivers load. The main StealthPDF app is x64 and cannot load 32-bit TWAIN drivers, so it
         launches this x86 helper out-of-process to enumerate and acquire from TWAIN scanners. -->
    <PlatformTarget>x86</PlatformTarget>
    <AssemblyName>StealthPDF.TwainHelper</AssemblyName>
    <RootNamespace>StealthPDF.TwainHelper</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <!-- Keep it self-contained: no Costura, no apphost config files cluttering output -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NTwain" Version="3.7.6" />
  </ItemGroup>

</Project>
