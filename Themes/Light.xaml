<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- StealthPDF light theme: clean paper-white panels on a soft gray canvas, one restrained
         blue accent. Flat and clean - no film grain, no glow, no header shadows. The blue here
         is the base accent; the other hues live in Accents/Light/*.xaml (incl. legacy green). -->
    <SolidColorBrush x:Key="BgDark"         Color="#EFF1F4" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgPanel"        Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgHover"        Color="#DEE3E9" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgSidebar"      Color="#E4E7EB" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgRecentPanel"  Color="#E9ECF0" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgFlyout"       Color="#FFFFFF" po:Freeze="True"/>
    <LinearGradientBrush x:Key="TabStripFadeBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0.0" Color="#00000000"/>
        <GradientStop Offset="0.55" Color="#12000000"/>
        <GradientStop Offset="1.0" Color="#3c000000"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BgModal"        Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="BorderDim"      Color="#D2D7DD" po:Freeze="True"/>
    <SolidColorBrush x:Key="Accent"         Color="#2F6FDE" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderAccent"   Color="#2F6FDE" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionAccent" Color="#2F6FDE" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentLogo"     Color="#2F6FDE" po:Freeze="True"/>
    <SolidColorBrush x:Key="InstallBtnBg"   Color="#2F6FDE" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentBorder"   Color="#C2C9D1" po:Freeze="True"/>
    <SolidColorBrush x:Key="DropBorder"     Color="#C2C9D1" po:Freeze="True"/>
    <SolidColorBrush x:Key="PaneBorder"     Color="#D9DDE3" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentDim"      Color="#DDE8FB" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionBg" Color="#2F6FDE" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionFg" Color="#ffffff" po:Freeze="True"/>
    <SolidColorBrush x:Key="SettingsOpenRowBg" Color="#DEE3E9" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextPrimary"    Color="#20242B" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextSecondary"  Color="#4A515A" po:Freeze="True"/>
    <SolidColorBrush x:Key="FilenameBrush"  Color="#4A515A" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextDim"        Color="#6C747E" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextFooter"     Color="#6C747E" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerRed"      Color="#D64545" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgDragHandle"   Color="#9AA3AD" po:Freeze="True"/>
    <SolidColorBrush x:Key="DragLine"       Color="#D9DDE3" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgScrollThumb"  Color="#662F6FDE" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#2F6FDE" po:Freeze="True"/>
    <SolidColorBrush x:Key="SliderTrack"    Color="#C2C9D1" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccent"    Color="#2F6FDE" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgOverlay"      Color="#8C000000" po:Freeze="True"/>
    <!-- Professional = flat: film grain and icon/header shadows OFF. -->
    <sys:Double x:Key="GrainOpacity">0</sys:Double>
    <sys:Double x:Key="IconShadowOpacity">0</sys:Double>
    <sys:Double x:Key="HeaderShadowOpacity">0</sys:Double>

    <SolidColorBrush x:Key="BgCanvas"                                                       Color="#D8DCE1" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                      Color="#DDE8FB" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                  Color="#2F6FDE" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#DDE8FB" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#2F6FDE" po:Freeze="True"/>

</ResourceDictionary>
