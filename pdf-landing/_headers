/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Content-addressed by filename and never edited in place - safe to pin hard.
/screenshots/*
  Cache-Control: public, max-age=31536000, immutable

/typewriter-headers.woff2
  Cache-Control: public, max-age=31536000, immutable

/typewriter-headers.ttf
  Cache-Control: public, max-age=31536000, immutable

/grain.png
  Cache-Control: public, max-age=31536000, immutable

/og-image.png
  Cache-Control: public, max-age=604800

/kp-icon.png
  Cache-Control: public, max-age=604800

/kp-icon.ico
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

# kp.css / kp.js are cache-busted by query string (?v=N) - bump it when editing.
/kp.css
  Cache-Control: public, max-age=86400

/kp.js
  Cache-Control: public, max-age=86400

# HTML must revalidate so a new release's version/hash is picked up promptly.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# The installer is replaced in place at each release - never serve a stale one.
/download/*
  Cache-Control: public, max-age=0, must-revalidate
